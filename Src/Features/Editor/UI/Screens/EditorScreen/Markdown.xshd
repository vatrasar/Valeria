<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="Markdown"
                  extensions=".md;.markdown;.mdown;.mkd;.mdx"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Heading" foreground="#4FA3E0" fontWeight="bold" />
  <Color name="Bold" foreground="#DCDCAA" fontWeight="bold" />
  <Color name="Italic" foreground="#C586C0" fontStyle="italic" />
  <Color name="Strike" foreground="#808080" />
  <Color name="InlineCode" foreground="#CE9178" background="#2D2D2D" />
  <Color name="CodeFence" foreground="#CE9178" background="#1F1F1F" />
  <Color name="Link" foreground="#4FA3E0" />
  <Color name="List" foreground="#C586C0" />
  <Color name="Quote" foreground="#808080" fontStyle="italic" />
  <Color name="Rule" foreground="#6E7681" />
  <Color name="Punctuation" foreground="#808080" />

  <RuleSet>
    <Span color="CodeFence" begin="^```" end="^```" />

    <Rule color="Heading">^\#{1,6}[ \t].*$</Rule>
    <Rule color="Quote">^\s*&gt;.*$</Rule>
    <Rule color="List">^([ \t]*)([-+*]|[0-9]+[.)])[ \t]</Rule>
    <Rule color="List">^([ \t]*)\[[ xX]\][ \t]</Rule>
    <Rule color="Rule">^([ \t]*)([*_-][ \t]*){3,}$</Rule>

    <Span color="Bold" begin="\*\*" end="\*\*" />
    <Span color="Bold" begin="__" end="__" />
    <Span color="Strike" begin="~~" end="~~" />
    <Span color="Italic" begin="\*" end="\*" />
    <Span color="Italic" begin="(?&lt;=[ \t(\[{])_(?=[^_])" end="_(?=[ \t)\].,:;!?]|$)" />

    <Rule color="InlineCode">`[^`]+`</Rule>
    <Rule color="Link">!?\[[^\]]*\]\([^)]*\)</Rule>
    <Rule color="Link">!?\[[^\]]*\]\[[^\]]*\]</Rule>
    <Rule color="Link">&lt;https?://[^&gt; \t]+&gt;</Rule>
    <Rule color="Punctuation">^[ \t]*(\||:?-+:?\|)</Rule>
  </RuleSet>
</SyntaxDefinition>
