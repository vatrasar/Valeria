<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Border.filesDock">
    <Setter Property="Width" Value="270" />
    <Setter Property="Background" Value="{DynamicResource ChromeBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.filesDock.collapsed">
    <Setter Property="Width" Value="0" />
  </Style>

  <Style Selector="Border.dockHeader">
    <Setter Property="Background" Value="{DynamicResource ChromeBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style Selector="TextBlock.dockTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.modeSwitchContainer">
    <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>

  <Style Selector="Button.modeButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.modeButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource TableHeaderBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="Button.modeButton.active">
    <Setter Property="Background" Value="{DynamicResource ChromeBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.addFavoritePanel">
    <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="8,8,8,4" />
  </Style>

  <Style Selector="TextBox.favoriteInput">
    <Setter Property="Background" Value="{DynamicResource ChromeBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="6,4" />
  </Style>

  <Style Selector="Border.itemCard">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style Selector="Border.itemCard:pointerover">
    <Setter Property="Background" Value="{DynamicResource TableHeaderBackgroundBrush}" />
  </Style>

  <Style Selector="Border.summitCard">
    <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="8,8,8,4" />
  </Style>

  <Style Selector="Border.summitCard:pointerover">
    <Setter Property="Background" Value="{DynamicResource TableHeaderBackgroundBrush}" />
  </Style>

  <Style Selector="TextBlock.itemTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.itemSubtitle">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <Style Selector="TextBlock.badgeText">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="TextBlock.emptyMessage">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Margin" Value="16,24" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Button.cardButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="Button.cardButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource TableHeaderBackgroundBrush}" />
  </Style>

  <Style Selector="Button.removeCardButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="Button.removeCardButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource TableHeaderBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>
</Styles>
