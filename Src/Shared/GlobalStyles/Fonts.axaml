<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <FontFamily x:Key="ProseFontFamily">Inter</FontFamily>
  <FontFamily x:Key="MonoFontFamily">Cascadia Code, Consolas, DejaVu Sans Mono, monospace</FontFamily>

  <sys:Double x:Key="BodyFontSize">16</sys:Double>
  <sys:Double x:Key="CodeFontSize">13.5</sys:Double>
  <sys:Double x:Key="Heading1FontSize">30</sys:Double>
  <sys:Double x:Key="Heading2FontSize">24</sys:Double>
  <sys:Double x:Key="Heading3FontSize">22</sys:Double>
  <sys:Double x:Key="Heading4FontSize">20</sys:Double>
  <sys:Double x:Key="Heading5FontSize">18</sys:Double>
  <sys:Double x:Key="Heading6FontSize">16</sys:Double>
</ResourceDictionary>
