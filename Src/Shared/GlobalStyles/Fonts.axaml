<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <FontFamily x:Key="ProseFontFamily">Inter</FontFamily>
  <FontFamily x:Key="MonoFontFamily">Cascadia Code, Consolas, DejaVu Sans Mono, monospace</FontFamily>

  <sys:Double x:Key="BodyFontSize">16</sys:Double>
  <sys:Double x:Key="CodeFontSize">13.5</sys:Double>
  <sys:Double x:Key="Heading1FontSize">32</sys:Double>
  <sys:Double x:Key="Heading2FontSize">25</sys:Double>
  <sys:Double x:Key="Heading3FontSize">21</sys:Double>
  <sys:Double x:Key="Heading4FontSize">18</sys:Double>
  <sys:Double x:Key="Heading5FontSize">15.5</sys:Double>
  <sys:Double x:Key="Heading6FontSize">14</sys:Double>
</ResourceDictionary>
